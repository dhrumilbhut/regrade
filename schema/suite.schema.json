{
  "title": "Regrade test suite",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "defaults": {
      "type": "object",
      "properties": {
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "judge": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "pricing": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "inputPerMTok": {
            "type": "number",
            "minimum": 0
          },
          "outputPerMTok": {
            "type": "number",
            "minimum": 0
          },
          "cachedInputPerMTok": {
            "type": "number",
            "minimum": 0
          },
          "cacheWrite5mPerMTok": {
            "type": "number",
            "minimum": 0
          },
          "cacheWrite1hPerMTok": {
            "type": "number",
            "minimum": 0
          },
          "validUntil": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "provider",
          "model",
          "inputPerMTok",
          "outputPerMTok"
        ],
        "additionalProperties": false
      }
    },
    "pipeline": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "adapter",
        "config"
      ],
      "additionalProperties": false
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "input": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "messages": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "system",
                            "user",
                            "assistant"
                          ]
                        },
                        "content": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "role",
                        "content"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "messages"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            ]
          },
          "expected": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scorers": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scorerConfig": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "repeat": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "timeoutMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "manual",
                  "production-flag",
                  "synthetic"
                ]
              },
              "ref": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "input",
          "scorers"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "pipeline",
    "cases"
  ],
  "additionalProperties": false
}
